# ============================================================
# KCIA - Karnataka Crime Intelligence Application
# Environment Configuration
# ============================================================

# --- Application ---
APP_NAME=KCIA
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_V1_STR=/api/v1

# --- PostgreSQL ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kcia_user
POSTGRES_PASSWORD=kcia_secret_password
POSTGRES_DB=kcia_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# --- AI Providers (set only the one you use) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
